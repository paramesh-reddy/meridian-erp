# Application Server & JWT Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="replace_with_secure_random_secret"
JWT_REFRESH_SECRET="replace_with_secure_random_refresh_secret"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Live Preview uses SQLite; FastAPI/MySQL backend uses backend/.env)
SQLITE_DB_PATH="./data/sales_inventory.db"

# SMTP Email Configuration (Optional — falls back to logged delivery queue when unconfigured)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@example.com"
SMTP_PASSWORD="your_app_password"
SMTP_FROM_NAME="Meridian ERP Approvals"
MANAGER_EMAIL="manager@example.com"

# Frontend API Base URL (defaults to /api/v1 on same-origin; set http://localhost:8000/api/v1 for FastAPI)
VITE_API_BASE_URL="/api/v1"
